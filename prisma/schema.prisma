generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tag {
  id          String   @id @default(uuid())
  description String
  color       String
  createdAt   DateTime @default(now())
  order       Int      @default(1)
  userId      String
  ticket      Ticket[]

  @@map("tags")
}

model Ticket {
  id          String    @id @default(uuid())
  description String
  done        Boolean   @default(false)
  date        DateTime?
  createdAt   DateTime  @default(now())
  order       Int       @default(1)
  userId      String
  tagId       String?

  tag Tag? @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@map("tickets")
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String
  toolCalls      Json?
  toolCallId     String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}
